{
    "name": "denysmedvid/pdfparser",
    "description": "Pdf parser library with secured/encrypted PDF support. A fork of smalot/pdfparser that can read and extract information from pdf files, including encrypted ones (RC4 40/128-bit, AES-128 and AES-256).",
    "keywords": ["PDF", "text", "parser", "parse", "extract", "encrypted", "secured", "decrypt"],
    "type": "library",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Sebastien MALOT",
            "email": "sebastien@malot.fr"
        }
    ],
    "support": {
        "issues": "https://github.com/smalot/pdfparser/issues"
    },
    "homepage": "https://www.pdfparser.org",
    "require": {
        "php": ">=7.1",
        "symfony/polyfill-mbstring": "^1.18",
        "ext-zlib": "*",
        "ext-iconv": "*",
        "ext-openssl": "*"
    },
    "replace": {
        "smalot/pdfparser": "self.version"
    },
    "autoload": {
        "psr-0": {
            "Smalot\\PdfParser\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PerformanceTests\\": "tests/Performance/",
            "PHPUnitTests\\": "tests/PHPUnit/"
        }
    },
    "config": {
        "process-timeout": 1200
    }
}
